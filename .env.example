# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
DATABASE_PATH=./data/a1_voice_tutor.sqlite3
CORS_ORIGINS=http://localhost:3000

# Local speech-to-text: faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local text-to-speech: Piper
# No API key or paid service is required.
PIPER_VOICE=ru_RU-dmitri-medium
PIPER_MODEL_DIR=./data/piper
PIPER_VOICE_REPO=https://huggingface.co/rhasspy/piper-voices/resolve/main
TTS_CACHE_DIR=./data/tts_cache
