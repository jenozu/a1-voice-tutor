# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
DATABASE_PATH=./data/a1_voice_tutor.sqlite3
CORS_ORIGINS=http://localhost:3000

# Local speech-to-text
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Azure neural text-to-speech
# Keep AZURE_SPEECH_KEY server-side. Never expose it as NEXT_PUBLIC_*.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
AZURE_TTS_VOICE=ru-RU-SvetlanaNeural
AZURE_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
TTS_CACHE_DIR=./data/tts_cache
