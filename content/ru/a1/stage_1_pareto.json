{
  "schema_version": 1,
  "language": "ru",
  "level": "A1",
  "stage": 1,
  "title": "Pareto Russian Survival Core",
  "selection_model": {
    "method": "Pareto-inspired utility prioritization",
    "note": "This is not presented as a literal corpus-frequency top-100 ranking. Items are prioritized for commonness, combinability, beginner survival value and reuse across many sentences.",
    "core_building_blocks": 65,
    "conversational_chunks": 35,
    "session_size": 10
  },
  "mastery_gate": {
    "recognition_percent": 80,
    "production_percent": 70,
    "rule": "Advance when both thresholds are met; continue reviewing weak items through spaced repetition instead of waiting for 100%."
  },
  "teaching_cycle": [
    "understand the meaning",
    "hear the Russian",
    "say it aloud",
    "recognize the Cyrillic",
    "recall from English without looking",
    "recombine it in a short sentence or dialogue",
    "send weak items to spaced review"
  ],
  "romanization_policy": {
    "sessions_1_to_3": "visible by default",
    "sessions_4_to_6": "available as a hint",
    "sessions_7_to_10": "hidden by default; reveal only when needed"
  },
  "practice_rules": {
    "new_items_per_session": 10,
    "five_second_recall": true,
    "immediate_recombination": true,
    "speaking_required": true,
    "passive_rereading_is_not_mastery": true
  },
